DJANGO_SECRET_KEY=change-me-generate-a-real-one
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=

# Production database (Render + external Neon Postgres, per spec Section 7
# step 10). Leave blank for local dev — settings.py falls back to
# SQLite when this is unset.
DATABASE_URL=

# --- Production (Render) only — set these in Render's dashboard, NOT here ---
#   DJANGO_SECRET_KEY   secret; generate fresh, never the dev value
#   DJANGO_DEBUG        False
#   DATABASE_URL        secret; from the Neon dashboard
# ALLOWED_HOSTS / CSRF_TRUSTED_ORIGINS are auto-derived from Render's
# RENDER_EXTERNAL_HOSTNAME (see settings.py). CORS_ALLOWED_ORIGINS is not
# needed — the deploy is single-origin.
