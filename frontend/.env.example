# Base URL the SPA prepends to API calls.
# Empty = same origin: dev goes through the Vite proxy (see vite.config.js),
# prod is served by Django + whitenoise from the same host. Only set this
# for a split-origin deployment.
VITE_API_BASE=

# Dev only: where the Vite proxy forwards /api, /admin, /accounts, /static,
# /media. Override if the Django dev server isn't on port 8000.
VITE_PROXY_TARGET=http://127.0.0.1:8000
